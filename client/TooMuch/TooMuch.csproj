<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: no console window. Exe=console subsystem pops a blinking
         console at every logon (tray task) and is useless for --service
         (session 0 has no visible console anyway). Console.WriteLine
         calls become harmless no-ops. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>TooMuch</AssemblyName>
    <RootNamespace>TooMuch</RootNamespace>
    <Version>0.2.3</Version>
    <!-- single exe, 1 binary, 2 modes: service and tray -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
